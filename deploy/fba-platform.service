[Unit]
Description=Source Reveal platform
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fba-platform
EnvironmentFile=/opt/fba-platform/.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8110
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
